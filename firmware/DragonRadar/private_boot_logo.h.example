#pragma once

// Copy this file to private_boot_logo.h and set USE_PRIVATE_BOOT_LOGO=1 in
// build flags if you want to use your own private boot mark.
//
// Keep this function signature. The main sketch will call it during boot.

static inline float privateLogoStep(float edge0, float edge1, float x) {
  float t = (x - edge0) / (edge1 - edge0);
  if (t < 0.0f) {
    t = 0.0f;
  } else if (t > 1.0f) {
    t = 1.0f;
  }
  return t * t * (3.0f - 2.0f * t);
}

static inline void drawPrivateCapsuleShape(Arduino_GFX *gfx, int cx, int cy, int w, int h,
                                           uint16_t fill, uint16_t outline) {
  const int r = h / 2;
  gfx->fillRect(cx - w / 2 + r, cy - h / 2, w - h, h, fill);
  gfx->fillCircle(cx - w / 2 + r, cy, r, fill);
  gfx->fillCircle(cx + w / 2 - r, cy, r, fill);
  for (int i = 0; i < 3; ++i) {
    gfx->drawCircle(cx - w / 2 + r, cy, r - i, outline);
    gfx->drawCircle(cx + w / 2 - r, cy, r - i, outline);
    gfx->drawFastHLine(cx - w / 2 + r, cy - r + i, w - h, outline);
    gfx->drawFastHLine(cx - w / 2 + r, cy + r - i, w - h, outline);
  }
}

inline void drawPrivateBootLogo(Arduino_GFX *gfx, int cx, int cy, float phase) {
  const uint16_t blue = RGB565(0, 86, 220);
  const uint16_t deepBlue = RGB565(0, 32, 126);
  const uint16_t white = RGB565_WHITE;
  const uint16_t glow = RGB565(78, 166, 255);
  const uint16_t gridDeep = RGB565(0, 42, 76);
  const uint16_t gridDim = RGB565(0, 64, 104);
  const int pulse = 6 + static_cast<int>(sinf(phase * 3.1415926f) * 12.0f);
  const float frame = privateLogoStep(0.0f, 0.26f, phase);
  const float body = privateLogoStep(0.16f, 0.54f, phase);
  const float mark = privateLogoStep(0.42f, 0.70f, phase);
  const float word = privateLogoStep(0.58f, 0.92f, phase);

  if (frame > 0.0f) {
    const int frameHalfW = static_cast<int>((117 + pulse / 2) * frame);
    const int frameHalfH = 53 + pulse / 3;
    gfx->drawRect(cx - frameHalfW, cy - frameHalfH, frameHalfW * 2, 106 + pulse / 2, gridDeep);
    gfx->drawFastHLine(cx - static_cast<int>(128 * frame), cy, static_cast<int>(256 * frame), glow);
    if (frame > 0.55f) {
      gfx->drawFastVLine(cx, cy - static_cast<int>(64 * frame), static_cast<int>(128 * frame), deepBlue);
      gfx->drawFastHLine(cx - static_cast<int>(116 * frame), cy - 50,
                         static_cast<int>(232 * frame), deepBlue);
      gfx->drawFastHLine(cx - static_cast<int>(116 * frame), cy + 50,
                         static_cast<int>(232 * frame), deepBlue);
    }
  }

  if (body > 0.0f) {
    const int capsuleW = 72 + static_cast<int>(118.0f * body);
    const int capsuleH = 40 + static_cast<int>(34.0f * body);
    drawPrivateCapsuleShape(gfx, cx, cy, capsuleW, capsuleH, body > 0.55f ? white : RGB565(154, 214, 255), blue);
    const int scanX = cx - capsuleW / 2 + static_cast<int>(capsuleW * body);
    gfx->drawFastVLine(scanX, cy - capsuleH / 2 - 8, capsuleH + 16, glow);
  }

  if (mark > 0.0f) {
    const int r = 10 + static_cast<int>(18.0f * mark);
    gfx->fillCircle(cx - 58, cy, r, blue);
    gfx->drawCircle(cx - 58, cy, r + 1, deepBlue);
    if (mark > 0.62f) {
      gfx->setTextColor(white);
      gfx->setTextSize(4);
      gfx->setCursor(cx - 71, cy - 17);
      gfx->print("C");
    }
  }

  if (word > 0.0f) {
    const int lineW = static_cast<int>(116.0f * word);
    gfx->drawLine(cx - 38, cy - 23, cx - 38 + lineW, cy - 23, word > 0.5f ? blue : gridDim);
    gfx->drawLine(cx - 38, cy + 23, cx - 38 + lineW, cy + 23, word > 0.5f ? blue : gridDim);
    if (word > 0.58f) {
      gfx->setTextColor(blue);
      gfx->setTextSize(2);
      gfx->setCursor(cx - 24, cy - 15);
      gfx->print("CAPSULE");
    }
    if (word > 0.78f) {
      gfx->setCursor(cx + 7, cy + 6);
      gfx->print("CORP.");
    }
  }
}
